{
  "name": "arduino-to-codespaces-bridge",
  "displayName": "Arduino to Codespaces Bridge",
  "description": "Compile and upload Arduino sketches from GitHub Codespaces to physical boards via Web Serial",
  "version": "2.0.3",
  "publisher": "benpaddlejones",
  "license": "MIT",
  "icon": "resources/icons/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/benpaddlejones/Codespaces_Arduino_Bridge"
  },
  "engines": {
    "vscode": "^1.82.0"
  },
  "extensionDependencies": [
    "ms-vscode.cpptools",
    "xaver.clang-format"
  ],
  "extensionPack": [
    "usernamehw.errorlens"
  ],
  "categories": [
    "Programming Languages",
    "Education",
    "Other"
  ],
  "keywords": [
    "arduino",
    "codespaces",
    "github",
    "embedded",
    "microcontroller",
    "web serial",
    "upload",
    "flash"
  ],
  "activationEvents": [
    "workspaceContains:**/*.ino"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "arduinoBridge.openBridge",
        "title": "Open Arduino to Codespaces Bridge",
        "category": "Arduino",
        "icon": "$(plug)"
      },
      {
        "command": "arduinoBridge.startServer",
        "title": "Start Bridge Server",
        "category": "Arduino"
      },
      {
        "command": "arduinoBridge.stopServer",
        "title": "Stop Bridge Server",
        "category": "Arduino"
      },
      {
        "command": "arduinoBridge.restartServer",
        "title": "Restart Bridge Server",
        "category": "Arduino"
      },
      {
        "command": "arduinoBridge.selectBoard",
        "title": "Select Board",
        "category": "Arduino"
      },
      {
        "command": "arduinoBridge.compileSketch",
        "title": "Compile Sketch",
        "category": "Arduino"
      },
      {
        "command": "arduinoBridge.refreshLibraries",
        "title": "Refresh Libraries",
        "category": "Arduino",
        "icon": "$(refresh)"
      },
      {
        "command": "arduinoBridge.refreshBoards",
        "title": "Refresh Boards",
        "category": "Arduino",
        "icon": "$(refresh)"
      },
      {
        "command": "arduinoBridge.syncEnvironmentConfig",
        "title": "Sync Environment Config",
        "category": "Arduino",
        "icon": "$(sync)"
      }
    ],
    "configuration": {
      "title": "Arduino to Codespaces Bridge",
      "properties": {
        "arduinoBridge.serverPort": {
          "type": "number",
          "default": 3000,
          "description": "Port for the Arduino Bridge server"
        },
        "arduinoBridge.autoStartServer": {
          "type": "boolean",
          "default": true,
          "description": "Automatically start the bridge server when a .ino file is detected"
        },
        "arduinoBridge.defaultBoard": {
          "type": "string",
          "default": "arduino:avr:uno",
          "description": "Default board FQBN for compilation"
        },
        "arduinoBridge.sketchPaths": {
          "type": "array",
          "default": [],
          "description": "Additional paths to search for sketches"
        },
        "arduinoBridge.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show Arduino Bridge status in the status bar"
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "when": "resourceExtname == .ino",
          "command": "arduinoBridge.openBridge",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "when": "resourceExtname == .ino",
          "command": "arduinoBridge.compileSketch",
          "group": "arduino@1"
        },
        {
          "when": "resourceExtname == .ino",
          "command": "arduinoBridge.openBridge",
          "group": "arduino@2"
        }
      ],
      "view/title": [
        {
          "command": "arduinoBridge.refreshBoards",
          "when": "view == arduinoBridge.boards",
          "group": "navigation"
        },
        {
          "command": "arduinoBridge.refreshLibraries",
          "when": "view == arduinoBridge.libraries",
          "group": "navigation"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "arduino-bridge",
          "title": "Arduino to Codespaces Bridge",
          "icon": "resources/icons/arduino-activity.svg"
        }
      ]
    },
    "views": {
      "arduino-bridge": [
        {
          "id": "arduinoBridge.status",
          "name": "Status"
        },
        {
          "id": "arduinoBridge.boards",
          "name": "Boards"
        },
        {
          "id": "arduinoBridge.libraries",
          "name": "Libraries"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "arduinoBridge.status",
        "contents": "[$(globe) Open Arduino Bridge](command:arduinoBridge.openBridge)"
      }
    ],
    "portsAttributes": {
      "3000": {
        "label": "Arduino Bridge Server",
        "onAutoForward": "openBrowserOnce",
        "elevateIfNeeded": false,
        "requireLocalPort": true
      }
    },
    "configurationDefaults": {
      "files.associations": {
        "*.ino": "cpp",
        "*.pde": "cpp"
      },
      "C_Cpp.formatting": "clangFormat",
      "C_Cpp.intelliSenseEngine": "default",
      "C_Cpp.default.intelliSenseMode": "gcc-x64",
      "C_Cpp.default.cppStandard": "c++11",
      "C_Cpp.default.cStandard": "c11",
      "C_Cpp.errorSquiggles": "enabled",
      "C_Cpp.autocompleteAddParentheses": true,
      "[cpp]": {
        "editor.defaultFormatter": "xaver.clang-format",
        "editor.formatOnSave": true,
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.quickSuggestions": {
          "other": true,
          "comments": false,
          "strings": false
        },
        "editor.suggest.snippetsPreventQuickSuggestions": false,
        "editor.wordBasedSuggestions": "matchingDocuments",
        "editor.suggestOnTriggerCharacters": true
      },
      "[c]": {
        "editor.defaultFormatter": "xaver.clang-format",
        "editor.formatOnSave": true,
        "editor.tabSize": 2,
        "editor.insertSpaces": true
      },
      "cSpell.words": [
        "Arduino",
        "FQBN",
        "GPIO",
        "PWM",
        "EEPROM",
        "WiFi",
        "Uno",
        "Nano",
        "Mega",
        "Renesas",
        "digitalWrite",
        "digitalRead",
        "analogWrite",
        "analogRead",
        "pinMode",
        "millis",
        "micros",
        "Serial",
        "PROGMEM",
        "ATmega",
        "AVR",
        "ESP",
        "ESP32",
        "ESP8266",
        "STM32",
        "SAMD",
        "Teensy",
        "Portenta",
        "Opta",
        "Giga",
        "MKR",
        "SPI",
        "I2C",
        "TWI",
        "UART",
        "USART",
        "ISR",
        "IRQ",
        "ADC",
        "DAC",
        "LED",
        "RGB",
        "servo",
        "stepper",
        "baud",
        "baudrate",
        "bitRead",
        "bitWrite",
        "bitSet",
        "bitClear",
        "highByte",
        "lowByte",
        "attachInterrupt",
        "detachInterrupt",
        "noInterrupts",
        "interrupts",
        "delayMicroseconds",
        "pulseIn",
        "pulseInLong",
        "shiftIn",
        "shiftOut",
        "tone",
        "noTone",
        "constrain",
        "remap",
        "sizeof",
        "bootloader",
        "firmware",
        "hexfile",
        "ihex",
        "avrdude",
        "bossac",
        "esptool",
        "platformio",
        "INO",
        "ino",
        "pde",
        "nRF",
        "Seeed",
        "Adafruit",
        "SparkFun",
        "DFRobot",
        "Elegoo",
        "Wemos",
        "NodeMCU",
        "FTDI",
        "CH340",
        "CP210x"
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run fetch:cli && npm run build:web && npm run build",
    "fetch:cli": "bash scripts/fetch-arduino-cli.sh",
    "build": "node esbuild.js --production",
    "build:web": "cd web-client && npm install && npm run build",
    "watch": "node esbuild.js --watch",
    "lint": "eslint src --ext ts",
    "test": "vscode-test",
    "test:intellisense": "node test/intellisense.test.mjs",
    "test:version": "node test/version.test.mjs",
    "test:meta": "node test/meta.test.mjs",
    "test:contracts": "node test/contracts.test.mjs",
    "test:webclient": "node test/webclient.test.mjs",
    "test:serial-flow": "node test/serial-flow.test.mjs",
    "test:compile-feedback": "node test/compile-feedback.test.mjs",
    "test:all": "node test/version.test.mjs && node test/meta.test.mjs && node test/contracts.test.mjs && node test/webclient.test.mjs && node test/serial-flow.test.mjs && node test/compile-feedback.test.mjs",
    "package": "vsce package",
    "publish": "vsce publish",
    "compile": "tsc -p ./"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.74.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vscode/test-electron": "^2.3.8",
    "@vscode/vsce": "^2.22.0",
    "esbuild": "^0.19.8",
    "eslint": "^8.55.0",
    "typescript": "^5.3.2"
  },
  "dependencies": {
    "express": "^4.21.2"
  }
}
