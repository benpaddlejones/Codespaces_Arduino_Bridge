/*
 * I2C Device Scanner
 *
 * Bundled diagnostic sketch used by the Arduino Bridge "I2C Scan" tool.
 * Probes every address on the default Wire bus (0x08-0x77), reports each
 * device found together with a best-guess identification, then repeats
 * the scan every 10 seconds so late-opening serial monitors still see
 * results.
 *
 * Wiring: connect the device to the board's default SDA/SCL pins
 * (Uno/Nano: A4/A5, Mega: 20/21, R4/Zero/ESP32: labelled SDA/SCL).
 * Most modules need 4.7k pull-up resistors if not already on the board.
 */

#include <Wire.h>

struct KnownDevice {
  uint8_t addr;
  const char *name;
};

// Best-guess identification table for common I2C devices.
static const KnownDevice KNOWN_DEVICES[] = {
    {0x0D, "QMC5883L compass"},
    {0x1D, "ADXL345 accelerometer"},
    {0x1E, "HMC5883L compass"},
    {0x23, "BH1750 light sensor"},
    {0x27, "PCF8574 LCD backpack / IO expander"},
    {0x29, "VL53L0X distance / TSL2561 light"},
    {0x38, "AHT10/AHT20 temp+humidity"},
    {0x39, "TSL2561 light / APDS-9960 gesture"},
    {0x3C, "SSD1306/SH1106 OLED display"},
    {0x3D, "SSD1306 OLED (alt address)"},
    {0x3F, "PCF8574A LCD backpack"},
    {0x40, "INA219 current / HTU21D humidity / PCA9685 PWM"},
    {0x44, "SHT31/SHT40 temp+humidity"},
    {0x48, "ADS1115 ADC / TMP102 temp"},
    {0x4A, "ADS1115 ADC (alt address)"},
    {0x50, "AT24C EEPROM"},
    {0x51, "PCF8563 RTC"},
    {0x53, "ADXL345 accelerometer (alt)"},
    {0x57, "AT24C EEPROM / MAX30102 pulse"},
    {0x5A, "MLX90614 IR temp / CCS811 air quality"},
    {0x60, "MCP4725 DAC / ATECC crypto"},
    {0x61, "SCD30 CO2 sensor"},
    {0x62, "SCD40/SCD41 CO2 sensor"},
    {0x68, "MPU6050 IMU / DS1307/DS3231 RTC"},
    {0x69, "MPU6050 IMU (alt address)"},
    {0x76, "BMP280/BME280 pressure (alt)"},
    {0x77, "BMP280/BME280/BMP180 pressure"},
};

static const size_t KNOWN_DEVICE_COUNT =
    sizeof(KNOWN_DEVICES) / sizeof(KNOWN_DEVICES[0]);

// A floating (unwired / missing pull-ups) bus can ACK dozens of ghost
// addresses; a scan reporting more than this many hits is dismissed.
static const uint8_t FLOATING_BUS_THRESHOLD = 24;

static const char *lookupDeviceName(uint8_t addr) {
  for (size_t i = 0; i < KNOWN_DEVICE_COUNT; i++) {
    if (KNOWN_DEVICES[i].addr == addr) {
      return KNOWN_DEVICES[i].name;
    }
  }
  return "unknown device";
}

static void printHexAddress(uint8_t addr) {
  Serial.print(F("0x"));
  if (addr < 0x10) {
    Serial.print('0');
  }
  Serial.print(addr, HEX);
}

static void scanBus() {
  uint8_t found[16];
  uint8_t foundCount = 0;

  Serial.println(F("[I2C] Scanning addresses 0x08-0x77..."));

  for (uint8_t addr = 0x08; addr <= 0x77; addr++) {
    Wire.beginTransmission(addr);
    uint8_t result = Wire.endTransmission();
    if (result == 0) {
      if (foundCount < sizeof(found)) {
        found[foundCount] = addr;
      }
      foundCount++;
      if (foundCount > FLOATING_BUS_THRESHOLD) {
        Serial.println(
            F("[I2C] Too many addresses ACKed - floating bus (missing "
              "pull-ups?), scan aborted."));
        return;
      }
      Serial.print(F("[I2C] FOUND "));
      printHexAddress(addr);
      Serial.print(F(" - "));
      Serial.println(lookupDeviceName(addr));
    }
  }

  Serial.println();
  if (foundCount == 0) {
    Serial.println(F("[I2C] No devices found."));
    Serial.println(F("[I2C] Check: VCC/GND wiring, SDA/SCL not swapped, "
                     "pull-up resistors (4.7k) present."));
  } else {
    Serial.print(F("[I2C] === Summary: "));
    Serial.print(foundCount);
    Serial.println(F(" device(s) found ==="));
    uint8_t reportable =
        foundCount < sizeof(found) ? foundCount : sizeof(found);
    for (uint8_t i = 0; i < reportable; i++) {
      Serial.print(F("[I2C] "));
      printHexAddress(found[i]);
      Serial.print(F("  "));
      Serial.println(lookupDeviceName(found[i]));
    }
  }
  Serial.println(F("[I2C] Rescanning in 10 seconds..."));
  Serial.println();
}

void setup() {
  Serial.begin(115200);
  // Native-USB boards need a moment for the serial monitor to attach.
  unsigned long start = millis();
  while (!Serial && (millis() - start) < 3000) {
    delay(10);
  }
  Wire.begin();
  Serial.println();
  Serial.println(F("[I2C] Arduino Bridge I2C Scanner"));
}

void loop() {
  scanBus();
  delay(10000);
}

